# ==============================================================================
# PAKKA NOTE ENVIRONMENT CONFIGURATION
# ==============================================================================
# In Google AI Studio, add GNANI_API_KEY through the Secrets Panel.
# Secrets are injected into the server environment at runtime.
# NEVER commit or hardcode secrets into source code or client bundles.

# Gnani AI API Key (Required for live Gnani Prisma STT and Timbre TTS)
GNANI_API_KEY=""

# Gnani STT API Endpoint (Default: published v3 endpoint)
GNANI_STT_URL="https://api.vachana.ai/stt/v3"

# Gnani TTS Inference API Endpoint (Default: published v1 inference endpoint)
GNANI_TTS_URL="https://api.vachana.ai/api/v1/tts/inference"

# Gnani STT Default Settings
GNANI_STT_DEFAULT_LANG="en-IN"
GNANI_STT_FORMAT="transcribe"

# Gnani Timbre TTS Default Settings
GNANI_TTS_MODEL="timbre-v2.5"
GNANI_TTS_VOICE="Nalini"

# Server Port
PORT=3000
